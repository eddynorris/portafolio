---
import Layout from '../../layouts/Layout.astro';
import MvcApp from '../../components/parque-mvc/MvcApp.tsx';
import { CONCEPTOS } from '../../components/parque-mvc/layout';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const controles = [
  {
    t: 'Pausa total',
    d: 'El botón grande (o la barra espaciadora) detiene el ciclo donde esté: invitados, engranajes y nubes se congelan al instante.',
  },
  {
    t: 'Velocidad',
    d: '×0,5, ×1 o ×2. El reloj del parque acelera; el orden petición → controlador → modelo → controlador → vista no cambia, solo el tiempo.',
  },
  {
    t: 'Reiniciar',
    d: 'Vacía el parque y vuelve a arrancar la primera petición desde la taquilla.',
  },
  {
    t: 'Etiquetas',
    d: 'Muestra u oculta los rótulos flotantes de cada edificio si la escena se ve muy cargada.',
  },
];

const equivalencias = [
  ['Taquilla y arco', 'Petición HTTP o evento de UI', 'El usuario inicia; aquí no hay lógica'],
  [
    'Controlador (2 paradas)',
    'Controller o handler',
    'Recibe la petición, llama al modelo, recibe el resultado y elige la vista',
  ],
  ['Modelo', 'Dominio: entidades y reglas', 'Ejecuta la lógica y devuelve el resultado'],
  ['Vista', 'Template o componente', 'Dibuja el estado y genera la respuesta'],
  [
    'Arco verde',
    'HTTP response',
    'La respuesta sale al cliente — la vista no vuelve al controlador',
  ],
];

const precisiones = [
  'MVC nació en la interfaz de Smalltalk-80 (Xerox PARC) y se describe en Krasner & Pope (1988). Es un patrón de interfaz de usuario, no una arquitectura de software por sí solo.',
  'El parque muestra el flujo web —a veces llamado Model 2 (término de las JSP de Sun, frente al Modelo 1)—: petición → controlador → modelo → controlador → plantilla → respuesta. En el Smalltalk clásico el camino era más circular: el modelo notifica a sus dependientes (vistas) y la vista se repinta sola.',
  'El controlador es el hub: la petición pasa por él dos veces —al recibirla y al recibir el resultado del modelo—. La vista NO devuelve nada al controlador: su render es la respuesta que sale hacia el cliente.',
  'El controlador no devuelve HTML ni ejecuta SQL: traduce la entrada en órdenes al modelo y, cuando hace falta, a la vista; en la web además elige qué vista se renderiza. Si empieza a hacer de negocio o de presentación, algo anda mal.',
  'MVC no es “tres capas”. Es un reparto de papeles entre modelo, vista y controlador, no una arquitectura por niveles: suele implementarse dentro de la capa de presentación de una app con capas, con el modelo en la capa de negocio — y a la vez puede existir MVC sin capas y capas sin MVC. La confusión es común porque muchos frameworks usan las tres palabras a la vez.',
  'En Django el patrón se llama Model–View–Template: la capa llamada “vista” asume el papel de despacho —más cercano al controlador de MVC— y la plantilla es la vista. Lee las responsabilidades, no los rótulos.',
];
---

<Layout
  title="Educador · MVC — Parque MVC"
  description="Simulación interactiva de Modelo-Vista-Controlador con estética de parque de atracciones: ciclo petición → controlador → modelo → controlador → vista → respuesta, controles de pausa y fichas en español."
>
  <MvcApp client:only="react" />

  <main>
    <!-- ============ CÓMO LEER ============ -->
    <section id="manual" class="pzSec">
      <div class="wrap">
        <p class="eyebrow reveal">Manual de uso</p>
        <h2 class="section-title reveal">Cómo se lee el parque</h2>

        <div class="pzLegend reveal">
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: var(--aji)"></span>
            <div>
              <h3>Un invitado = una petición</h3>
              <p>
                Entra por la taquilla con una cajita roja: es la petición cruda (GET /pedidos, un
                clic, un submit). La lleva hasta el controlador y se la entrega.
              </p>
            </div>
          </div>
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: var(--teal)"></span>
            <div>
              <h3>El controlador es el hub</h3>
              <p>
                Frente al kiosco teal se detiene dos veces: primero recibe la petición y despacha
                al modelo; después recibe el resultado y elige la vista.
              </p>
            </div>
          </div>
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: var(--amarillo)"></span>
            <div>
              <h3>El modelo calcula y devuelve</h3>
              <p>
                En la parada amarilla gira el engranaje (lógica del dominio). Al terminar, el
                invitado regresa al controlador con una cajita ámbar: el resultado.
              </p>
            </div>
          </div>
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: var(--fucsia)"></span>
            <div>
              <h3>La vista renderiza y responde</h3>
              <p>
                Última parada: la pantalla dibuja el estado. El invitado sale por el arco verde
                con la respuesta — que va al cliente, no al controlador.
              </p>
            </div>
          </div>
        </div>

        <div class="pzCtl reveal">
          <h3>Controles</h3>
          <ul>
            {
              controles.map((c) => (
                <li>
                  <strong>{c.t}.</strong> {c.d}
                </li>
              ))
            }
            <li>
              <strong>Tocar un edificio</strong> abre su ficha (también los rótulos y los botones
              del panel). Tocar el césped la cierra.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ LUGARES ============ -->
    <section class="pzSec pzSec--ink">
      <div class="wrap">
        <p class="eyebrow reveal">Fichas</p>
        <h2 class="section-title reveal">Los cuatro lugares del parque</h2>
        <div class="pzCards">
          {
            CONCEPTOS.map((c, i) => (
              <article class="pzCard reveal">
                <span class="pzCard__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="pzCard__tag">{c.tag}</span>
                <h3>{c.title}</h3>
                <p>{c.largo}</p>
                <p class="pzCard__regla">
                  <b>Regla:</b> {c.regla}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ TABLA ============ -->
    <section class="pzSec">
      <div class="wrap">
        <p class="eyebrow reveal">Mapa</p>
        <h2 class="section-title reveal">MVC, fila por fila</h2>
        <p class="pzLead reveal">
          La tabla muestra la <em>secuencia de una petición</em> —no el diagrama de dependencias—.
          En el código la flecha de dependencia se ve en otro punto: la vista depende del modelo,
          nunca al revés.
        </p>
        <div class="pzTableWrap reveal">
          <table class="pzTable">
            <thead>
              <tr>
                <th scope="col">En el parque</th>
                <th scope="col">En una app web</th>
                <th scope="col">Qué hace</th>
              </tr>
            </thead>
            <tbody>
              {
                equivalencias.map(([a, b, c]) => (
                  <tr>
                    <td>{a}</td>
                    <td>{b}</td>
                    <td>{c}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============ PRECISIÓN ============ -->
    <section class="pzSec pzSec--note">
      <div class="wrap">
        <p class="eyebrow reveal">Notación precisa</p>
        <h2 class="section-title reveal">Lo que este parque corrige</h2>
        <ol class="pzNotes reveal">
          {
            precisiones.map((p) => (
              <li>{p}</li>
            ))
          }
        </ol>
        <p class="pzSrc reveal">
          Fuentes: Glenn Krasner y Stephen Pope, <em>“A Cookbook for Using the Model-View-Controller
          User Interface Paradigm in Smalltalk-80”</em> (JOOP 1(3), 1988) · Steve Burbeck, <em>“Applications
          Programming in Smalltalk-80: How to Use Model-View-Controller (MVC)”</em> (1987, rev. 1992) ·
          Erich Gamma et al., <em>Design Patterns</em> (1995) · Martin Fowler, <em>Patterns of
          Enterprise Application Architecture</em> (2002) · Documentación de Django
          (Model–View–Template).
        </p>
      </div>
    </section>
  </main>

  <footer class="pzFoot">
    <div class="wrap pzFoot__inner">
      <div>
        <a class="btn" href={`${base}/`}>← Volver al inicio</a>
        <a class="btn btn--ghost pzFoot__alt" href={`${base}/educador/ddd-puertos-y-adaptadores`}>
          Ver el Parque DDD
        </a>
      </div>
      <p>Parque MVC · simulación hecha con Astro + React Three Fiber</p>
    </div>
  </footer>
</Layout>

<style>
  .pzSec {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    border-bottom: 3px solid var(--ink);
  }

  .pzSec .eyebrow {
    margin-bottom: 0.8rem;
  }

  .pzSec--ink {
    background: var(--ink);
    color: var(--cream);
  }

  .pzSec--ink .eyebrow {
    color: var(--cream);
  }

  .pzSec--note {
    background: color-mix(in srgb, var(--amarillo) 22%, var(--cream));
  }

  /* ---------- leyenda ---------- */
  .pzLegend {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
    gap: 1.1rem;
  }

  .pzLegend__item {
    display: flex;
    gap: 0.85rem;
    background: var(--paper);
    border: var(--stroke);
    border-radius: 14px;
    box-shadow: var(--shadow-hard-sm);
    padding: 1.1rem 1.1rem 1.2rem;
  }

  .pzDot {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.3rem;
    border-radius: 5px;
    border: 2px solid var(--ink);
    background: var(--c, var(--amarillo));
    transform: rotate(-6deg);
  }

  .pzLegend h3 {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
    min-height: 2.3em;
  }

  .pzLegend p {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .pzCtl {
    margin-top: 2.2rem;
    background: var(--paper);
    border: var(--stroke);
    border-radius: 14px;
    box-shadow: var(--shadow-hard-sm);
    padding: 1.3rem 1.4rem;
  }

  .pzCtl h3 {
    font-size: 1.15rem;
    margin-bottom: 0.7rem;
  }

  .pzCtl ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .pzCtl strong {
    color: var(--ink);
  }

  /* ---------- fichas ---------- */
  .pzCards {
    margin-top: 2.4rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.2rem;
  }

  .pzCard {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    border: var(--stroke);
    border-radius: 16px;
    box-shadow: var(--shadow-hard-sm);
    padding: 1.4rem 1.3rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .pzCard__num {
    position: absolute;
    top: -0.85rem;
    right: 1rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    background: var(--amarillo);
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .pzCard__tag {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .pzCard h3 {
    font-size: 1.28rem;
  }

  .pzCard p {
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .pzCard__regla {
    margin-top: auto;
    background: color-mix(in srgb, var(--amarillo) 38%, var(--cream));
    border: 2px solid var(--ink);
    border-radius: 10px;
    padding: 0.6rem 0.7rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink);
  }

  .pzCard__regla b {
    font-family: var(--font-display);
    margin-right: 0.3rem;
  }

  /* ---------- tabla ---------- */
  .pzLead {
    margin-top: 1.2rem;
    max-width: 46rem;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    color: var(--ink-soft);
  }

  .pzLead em {
    font-style: normal;
    font-weight: 700;
    color: var(--ink);
    background: linear-gradient(
      transparent 58%,
      var(--amarillo) 58%,
      var(--amarillo) 94%,
      transparent 94%
    );
  }

  .pzTableWrap {
    margin-top: 2.2rem;
    overflow-x: auto;
    border: var(--stroke);
    border-radius: 14px;
    box-shadow: var(--shadow-hard-sm);
    background: var(--paper);
  }

  .pzTable {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .pzTable th,
  .pzTable td {
    text-align: left;
    padding: 0.85rem 1.1rem;
    border-bottom: 2px solid color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .pzTable th {
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--cream);
  }

  .pzTable tr:last-child td {
    border-bottom: 0;
  }

  .pzTable td:last-child {
    font-weight: 600;
  }

  /* ---------- notas ---------- */
  .pzNotes {
    margin-top: 2rem;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 52rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  .pzNotes li {
    padding-left: 0.4rem;
  }

  .pzNotes li::marker {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--aji);
  }

  .pzSrc {
    margin-top: 1.8rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    max-width: 52rem;
  }

  .pzSrc em {
    font-style: italic;
  }

  /* ---------- footer ---------- */
  .pzFoot {
    background: var(--ink);
    color: var(--cream);
    padding-block: 2.2rem;
  }

  .pzFoot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.92rem;
  }

  .pzFoot__alt {
    margin-left: 0.7rem;
    color: var(--cream);
  }

  .pzFoot p {
    color: color-mix(in srgb, var(--cream) 60%, transparent);
  }

  @media (max-width: 720px) {
    .pzTable th,
    .pzTable td {
      padding: 0.7rem 0.8rem;
    }

    .pzFoot__alt {
      display: inline-block;
      margin: 0.8rem 0 0;
    }
  }
</style>
