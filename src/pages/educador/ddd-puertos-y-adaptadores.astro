---
import Layout from '../../layouts/Layout.astro';
import ParqueApp from '../../components/parque/ParqueApp.tsx';
import { CONCEPTOS } from '../../components/parque/park/layout';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const controles = [
  {
    t: 'Pausa total',
    d: 'El botón grande (o la barra espaciadora) detiene el flujo donde esté: invitados, eventos y nubes se congelan al instante.',
  },
  {
    t: 'Velocidad',
    d: '×0,5, ×1 o ×2. El reloj del parque acelera; las reglas del dominio no cambian, solo el tiempo.',
  },
  {
    t: 'Paso a paso',
    d: 'Congela la ruta en cada uno de los cinco pasos y deja un botón “Siguiente” para avanzar a tu ritmo. El parque sigue respirando mientras la ruta espera.',
  },
  {
    t: 'Reiniciar',
    d: 'Vacía el parque y vuelve a arrancar la primera solicitud desde la taquilla.',
  },
  {
    t: 'Etiquetas',
    d: 'Muestra u oculta los rótulos flotantes de cada edificio si la escena se ve muy cargada.',
  },
];

const equivalencias = [
  ['Entidad y Value Object', 'Núcleo del dominio, dentro del hexágono', 'El castillo'],
  ['Agregado y su raíz', 'Núcleo del dominio, dentro del hexágono', 'El interior del castillo'],
  ['Caso de uso / servicio de aplicación', 'Cumple el puerto y orquesta desde dentro', 'La oficina'],
  ['Puerto (contrato)', 'Interfaz en la frontera del hexágono', 'El enchufe de la valla'],
  ['Repositorio e infraestructura (SQL, SMTP, API externa)', 'Puertos salientes y adaptadores driven', 'Enchufe · bodega, antena y correo'],
  ['Contexto acotado', 'El hexágono de otro modelo', 'Las zonas cercadas'],
  ['Evento de dominio', 'Publicación hacia un puerto de salida', 'Los orbes → enchufe → correo'],
];

const precisiones = [
  'driving / primary = quien inicia la conversación; driven / secondary = a quien la aplicación llama. Algunos resúmenes invierten estos términos: lo que se sostiene en el texto de Cockburn es quién inicia y quién es llamado, no siempre el nombre que se le da a cada lado.',
  'Puertos y adaptadores salió en 2005 de la mano de Alistair Cockburn; el dibujo del hexágono es de 1994. El 6 no significa nada: el hexágono solo deja espacio para enchufar puertos.',
  'El hexágono original no define qué hay dentro: dibuja la frontera y sus enchufes. El reparto entre aplicación y dominio llega después, con las capas de Evans (2003), la Onion Architecture de Palermo (2008) y la Clean Architecture de Martin.',
  'Domain-Driven Design es de Eric Evans (2003). Los eventos de dominio no están en ese libro: Evans los describe en 2009 (QCon London) y hoy son parte del DDD táctico.',
  'Un agregado por transacción. Entre agregados, consistencia eventual: Vernon insiste en que los eventos se guardan en la misma transacción que el cambio del agregado y se entregan después del commit, cada suscriptor con la suya.',
  '“Las dependencias apuntan hacia dentro” es la formulación canónica de Clean Architecture. En Cockburn la regla es que el interior no dependa del exterior: los adaptadores importan los puertos que define la aplicación, nunca al revés.',
];

const glosario = [
  {
    t: 'Entidad vs. Value Object',
    d: 'La entidad tiene identidad y ciclo de vida: un Pedido se reconoce aunque cambie su contenido. El value object no: solo valor. Dos importes de 30 € son el mismo importe; dos pedidos con el mismo contenido, no.',
  },
  {
    t: 'Servicio de dominio vs. de aplicación',
    d: 'El de dominio expresa una regla de negocio que no cabe en una entidad ni en un VO, y habla el lenguaje ubicuo. El de aplicación (el caso de uso) solo orquesta: llama al dominio y a los puertos, sin reglas propias.',
  },
  {
    t: 'Inyección de dependencias',
    d: 'La aplicación declara qué necesita (el puerto) y quién decide qué llega es el exterior. El controlador REST, el CLI o un test pasan su adaptador al caso de uso: el núcleo nunca instancia SQL ni SMTP.',
  },
  {
    t: 'Relaciones entre contextos',
    d: 'Tres formas de convivir: anticorruption layer traduce el lenguaje ajeno al tuyo; lenguaje publicado expones tu modelo y el otro se adapta; cliente–proveedor reparte responsabilidades por contrato.',
  },
];
---

<Layout
  title="Educador · DDD, Puertos y Adaptadores — Parque DDD"
  description="Simulación interactiva de Domain-Driven Design y arquitectura hexagonal con estética de parque de atracciones: controles de pausa, flujo en vivo y fichas en español."
>
  <ParqueApp client:only="react" />

  <main id="main">
    <!-- ============ CÓMO LEER ============ -->
    <section id="manual" class="pzSec">
      <div class="wrap">
        <p class="eyebrow reveal">Manual de uso</p>
        <h2 class="section-title reveal">Cómo se lee el parque</h2>

        <div class="pzLegend reveal">
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: var(--aji)"></span>
            <div>
              <h3>Un invitado = una solicitud</h3>
              <p>
                Entra por la taquilla con una cajita. En cada cruce de frontera cambia de forma:
                JSON, comando rojo, objeto de pedido y filas en la base de datos.
              </p>
            </div>
          </div>
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: #8f6bd8"></span>
            <div>
              <h3>La oficina = el caso de uso</h3>
              <p>
                Recibe el comando, pregunta al repositorio, manda al agregado, guarda el
                resultado y publica el evento. El puerto es el contrato; ella es quien lo cumple.
              </p>
            </div>
          </div>
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: var(--amarillo)"></span>
            <div>
              <h3>Un orbe = un evento de dominio</h3>
              <p>
                El castillo lo registra sin salir por ningún puerto. Tras el commit, sale por el
                puerto de eventos hacia quien quiera escucharlo.
              </p>
            </div>
          </div>
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: var(--teal)"></span>
            <div>
              <h3>Ambos lados están fuera</h3>
              <p>
                La taquilla a la izquierda y la bodega, el correo y la antena a la derecha son
                adaptadores, igual de fuera. Los enchufes de la valla son los puertos; el
                hexágono solo tiene paredes y huecos.
              </p>
            </div>
          </div>
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: var(--lima-deep)"></span>
            <div>
              <h3>Las vallas = fronteras de contexto</h3>
              <p>
                Dentro de cada zona manda su propio lenguaje. Cruzar la valla con el mismo
                término no significa cruzar con el mismo modelo.
              </p>
            </div>
          </div>
        </div>

        <div class="pzCtl reveal">
          <h3>Controles</h3>
          <ul>
            {
              controles.map((c) => (
                <li>
                  <strong>{c.t}.</strong> {c.d}
                </li>
              ))
            }
            <li>
              <strong>Tocar un edificio</strong> abre su ficha (también los rótulos y los botones
              del panel). Tocar el césped la cierra.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ LUGARES ============ -->
    <section class="pzSec pzSec--ink">
      <div class="wrap">
        <p class="eyebrow reveal">Fichas</p>
        <h2 class="section-title reveal">Los lugares del parque</h2>
        <div class="pzCards">
          {
            CONCEPTOS.map((c, i) => (
              <article class="pzCard reveal">
                <span class="pzCard__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="pzCard__tag">{c.tag}</span>
                <h3>{c.title}</h3>
                <p>{c.largo}</p>
                <p class="pzCard__regla">
                  <b>Regla:</b> {c.regla}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ TABLA ============ -->
    <section class="pzSec">
      <div class="wrap">
        <p class="eyebrow reveal">Mapa</p>
        <h2 class="section-title reveal">DDD y hexagonal, capa por capa</h2>
        <p class="pzLead reveal">
          DDD te dice <em>qué modelar</em>; la arquitectura hexagonal te dice <em>cómo
          organizarlo</em>. Esta es la traducción entre ambos — y dónde vive cada fila del parque.
        </p>
        <div class="pzTableWrap reveal">
          <table class="pzTable">
            <thead>
              <tr>
                <th scope="col">DDD (qué modelar)</th>
                <th scope="col">Hexagonal (cómo se organiza)</th>
                <th scope="col">En el parque</th>
              </tr>
            </thead>
            <tbody>
              {
                equivalencias.map(([a, b, c]) => (
                  <tr>
                    <td>{a}</td>
                    <td>{b}</td>
                    <td>{c}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============ GLOSARIO ============ -->
    <section class="pzSec pzSec--ink">
      <div class="wrap">
        <p class="eyebrow reveal">Dudas frecuentes</p>
        <h2 class="section-title reveal">Cuatro pares que se confunden</h2>
        <div class="pzGlos">
          {
            glosario.map((g) => (
              <article class="pzGlos__item reveal">
                <h3>{g.t}</h3>
                <p>{g.d}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ PRECISIÓN ============ -->
    <section class="pzSec pzSec--note">
      <div class="wrap">
        <p class="eyebrow reveal">Notación precisa</p>
        <h2 class="section-title reveal">Lo que este parque corrige</h2>
        <ol class="pzNotes reveal">
          {
            precisiones.map((p) => (
              <li>{p}</li>
            ))
          }
        </ol>
        <p class="pzSrc reveal">
          Fuentes: Eric Evans, <em>Domain-Driven Design</em> (2003) y su charla sobre eventos de
          dominio (QCon London, 2009) · Alistair Cockburn,
          <em>Hexagonal Architecture</em> (2005) y <em>Hexagonal Architecture Explained</em> ·
          Vaughn Vernon, <em>Implementing Domain-Driven Design</em> (2013), con el prólogo de
          Eric Evans, y <em>Effective Aggregate Design</em> (2011) · Ralph Johnson y colaboradores
          sobre la Onion Architecture (2008) · Robert C. Martin, <em>Clean Architecture</em>
          (2017).
        </p>
      </div>
    </section>
  </main>

  <footer class="pzFoot">
    <div class="wrap pzFoot__inner">
      <a class="btn" href={`${base}/`}>← Volver al inicio</a>
      <p>Parque DDD · simulación hecha con Astro + React Three Fiber</p>
    </div>
  </footer>
</Layout>

<style>
  .pzSec {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    border-bottom: 3px solid var(--ink);
  }

  .pzSec .eyebrow {
    margin-bottom: 0.8rem;
  }

  .pzSec--ink {
    background: var(--ink);
    color: var(--cream);
  }

  .pzSec--ink .eyebrow {
    color: var(--cream);
  }

  .pzSec--note {
    background: color-mix(in srgb, var(--amarillo) 22%, var(--cream));
  }

  /* ---------- leyenda ---------- */
  .pzLegend {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
    gap: 1.1rem;
  }

  .pzLegend__item {
    display: flex;
    gap: 0.85rem;
    background: var(--paper);
    border: var(--stroke);
    border-radius: 14px;
    box-shadow: var(--shadow-hard-sm);
    padding: 1.1rem 1.1rem 1.2rem;
  }

  .pzDot {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.3rem;
    border-radius: 5px;
    border: 2px solid var(--ink);
    background: var(--c, var(--amarillo));
    transform: rotate(-6deg);
  }

  .pzLegend h3 {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
    min-height: 2.3em;
  }

  .pzLegend p {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .pzCtl {
    margin-top: 2.2rem;
    background: var(--paper);
    border: var(--stroke);
    border-radius: 14px;
    box-shadow: var(--shadow-hard-sm);
    padding: 1.3rem 1.4rem;
  }

  .pzCtl h3 {
    font-size: 1.15rem;
    margin-bottom: 0.7rem;
  }

  .pzCtl ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .pzCtl strong {
    color: var(--ink);
  }

  /* ---------- fichas ---------- */
  .pzCards {
    margin-top: 2.4rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.2rem;
  }

  .pzCard {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    border: var(--stroke);
    border-radius: 16px;
    box-shadow: var(--shadow-hard-sm);
    padding: 1.4rem 1.3rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .pzCard__num {
    position: absolute;
    top: -0.85rem;
    right: 1rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    background: var(--amarillo);
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .pzCard__tag {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .pzCard h3 {
    font-size: 1.28rem;
  }

  .pzCard p {
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .pzCard__regla {
    margin-top: auto;
    background: color-mix(in srgb, var(--amarillo) 38%, var(--cream));
    border: 2px solid var(--ink);
    border-radius: 10px;
    padding: 0.6rem 0.7rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink);
  }

  .pzCard__regla b {
    font-family: var(--font-display);
    margin-right: 0.3rem;
  }

  /* ---------- glosario ---------- */
  .pzGlos {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16.5rem, 1fr));
    gap: 1.1rem;
  }

  .pzGlos__item {
    background: color-mix(in srgb, var(--cream) 7%, transparent);
    border: 2px solid color-mix(in srgb, var(--cream) 32%, transparent);
    border-radius: 14px;
    padding: 1.15rem 1.15rem 1.2rem;
  }

  .pzGlos__item h3 {
    font-size: 1.05rem;
    margin-bottom: 0.45rem;
    color: var(--amarillo);
  }

  .pzGlos__item p {
    font-size: 0.92rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--cream) 82%, transparent);
  }

  /* ---------- tabla ---------- */
  .pzLead {
    margin-top: 1.2rem;
    max-width: 46rem;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    color: var(--ink-soft);
  }

  .pzLead em {
    font-style: normal;
    font-weight: 700;
    color: var(--ink);
    background: linear-gradient(
      transparent 58%,
      var(--amarillo) 58%,
      var(--amarillo) 94%,
      transparent 94%
    );
  }

  .pzTableWrap {
    margin-top: 2.2rem;
    overflow-x: auto;
    border: var(--stroke);
    border-radius: 14px;
    box-shadow: var(--shadow-hard-sm);
    background: var(--paper);
  }

  .pzTable {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .pzTable th,
  .pzTable td {
    text-align: left;
    padding: 0.85rem 1.1rem;
    border-bottom: 2px solid color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .pzTable th {
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--cream);
  }

  .pzTable tr:last-child td {
    border-bottom: 0;
  }

  .pzTable td:last-child {
    font-weight: 600;
  }

  /* ---------- notas ---------- */
  .pzNotes {
    margin-top: 2rem;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 52rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  .pzNotes li {
    padding-left: 0.4rem;
  }

  .pzNotes li::marker {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--aji);
  }

  .pzSrc {
    margin-top: 1.8rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    max-width: 52rem;
  }

  .pzSrc em {
    font-style: italic;
  }

  /* ---------- footer ---------- */
  .pzFoot {
    background: var(--ink);
    color: var(--cream);
    padding-block: 2.2rem;
  }

  .pzFoot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.92rem;
  }

  .pzFoot p {
    color: color-mix(in srgb, var(--cream) 60%, transparent);
  }

  @media (max-width: 720px) {
    .pzTable th,
    .pzTable td {
      padding: 0.7rem 0.8rem;
    }
  }
</style>
