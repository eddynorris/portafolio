---
import Layout from '../../layouts/Layout.astro';
import TacticaApp from '../../components/parque-tactica/TacticaApp.tsx';
import { CONCEPTOS } from '../../components/parque-tactica/layout';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const controles = [
  {
    t: 'Pausa total',
    d: 'El botón grande (o la barra espaciadora) detiene el flujo donde esté: residentes, eventos y nubes se congelan al instante.',
  },
  {
    t: 'Velocidad',
    d: '×0,5, ×1 o ×2. El reloj del parque acelera; las reglas del agregado no cambian, solo el tiempo.',
  },
  {
    t: 'Paso a paso',
    d: 'Congela la ruta en cada uno de los seis pasos —uno por frontera del modelo— y deja un botón “Siguiente” para avanzar a tu ritmo.',
  },
  {
    t: 'Reiniciar',
    d: 'Vacía la ciudadela y vuelve a arrancar el primer comando desde la verja oeste.',
  },
  {
    t: 'Etiquetas',
    d: 'Muestra u oculta los rótulos flotantes de cada sitio si la escena se ve muy cargada.',
  },
];

const equivalencias = [
  ['Comando', 'La orden de negocio que entra, una por transacción', 'El torno'],
  ['Agregado', 'El racimo que cambia y se guarda como una unidad', 'La ciudadela amurallada'],
  ['Raíz del agregado', 'La única puerta al interior: todo cambio pasa por ella', 'El puente'],
  ['Invariantes', 'Reglas que nunca pueden romperse: si fallan, no se aplica nada', 'La guardia'],
  ['Entidad', 'Identidad propia dentro del agregado', 'La sala de líneas'],
  ['Value Object', 'Valor inmutable: se reemplaza, no se muta', 'El cofre'],
  ['Evento de dominio', 'El hecho en pasado, anotado dentro del agregado', 'El registro'],
  ['Commit atómico', 'Agregado y eventos en la misma transacción', 'La bodega'],
  ['Publicación', 'Tras el commit, cada suscriptor en su propia transacción', 'El bus y el correo'],
];

const precisiones = [
  'La regla precisa es “modificar una instancia de agregado por transacción”. Puedes cargar varios agregados para leer en una operación, pero el que cambia es uno: es la formulación de Vaughn Vernon en Effective Aggregate Design, no una frase de Evans.',
  'Agregados pequeños: la frontera no la dicta la base de datos ni el diagrama de clases, sino la invariante que debe cumplirse en cada cambio. Si una línea puede cambiar sin pasar por el pedido, el límite está mal trazado.',
  'Referencias entre agregados por identidad: Pedido guarda un ClienteId, no un objeto Cliente. Así cada agregado se carga y se bloquea solo, y las transacciones se mantienen cortas.',
  'Los eventos de dominio no están en el libro azul de Evans (2003): los populariza en su charla de QCon London (2009). Hoy son parte del DDD táctico, con nombre en pasado y el hecho ya ocurrido: no son órdenes.',
  'Los eventos se guardan en la misma transacción que el cambio del agregado y se publican solo después del commit (Vernon). Si el suscriptor falla, el estado ya está a salvo; cada suscriptor procesa en su propia transacción.',
  'Evento de dominio ≠ evento de integración: el primero habla el lenguaje del modelo (LineaAgregada) y vive dentro del agregado; el segundo es el esquema que cruza a otro contexto, más estable y pensado para fuera.',
];

const glosario = [
  {
    t: 'Entidad vs. Value Object',
    d: 'La entidad tiene identidad: la línea 3 sigue siendo la línea 3 aunque cambie de cantidad. El VO no tiene identidad: dos importes de 30,00 € son el mismo importe. Por eso el VO es inmutable y se reemplaza.',
  },
  {
    t: 'Invariante vs. validación',
    d: 'Una validación puede ser un aviso; una invariante no admite excepción. Si el cambio la rompería, la raíz rechaza la operación entera: no queda a medias. Es el motivo de que exista el agregado.',
  },
  {
    t: 'Agregado vs. caso de uso',
    d: 'El caso de uso orquesta: carga el agregado por el repositorio, le pide el cambio, guarda y publica. El agregado decide: valida invariantes, cambia entidades, reemplaza VOs y anota eventos. Reparto de responsabilidades, no capas rígidas.',
  },
  {
    t: 'Evento de dominio vs. de integración',
    d: 'PedidoCreado describe el hecho dentro del modelo. Cuando cruza a otro contexto se traduce a un esquema publicado (PedidoAñadido) pensado para consumidores externos y más resistente al cambio.',
  },
];
---

<Layout
  title="Educador · Táctica de DDD — Parque Táctica"
  description="Simulación interactiva de DDD táctico con estética de castillo: agregados, raíces, invariantes, value objects y eventos de dominio, con paso a paso y fichas en español."
>
  <TacticaApp client:only="react" />

  <main id="main">
    <!-- ============ CÓMO LEER ============ -->
    <section id="manual" class="pzSec">
      <div class="wrap">
        <p class="eyebrow reveal">Manual de uso</p>
        <h2 class="section-title reveal">Cómo se lee la ciudadela</h2>

        <div class="pzLegend reveal">
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: var(--aji)"></span>
            <div>
              <h3>Un cliente + su caja = un comando</h3>
              <p>
                Entra por el oeste y espera ante el torno: una instancia de agregado por
                transacción. La caja cambia de forma al cruzar cada frontera del modelo.
              </p>
            </div>
          </div>
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: #8f6bd8"></span>
            <div>
              <h3>El residente trabaja el agregado</h3>
              <p>
                Lleva la caja al puente (la raíz), a la guardia (invariantes), a la sala
                (entidad) y al cofre (value object). Nunca sale de la ciudadela para cambiar el
                interior.
              </p>
            </div>
          </div>
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: var(--amarillo)"></span>
            <div>
              <h3>Un orbe = un evento de dominio</h3>
              <p>
                Al anotarse LineaAgregada aparece en el registro. No llama a nadie: viaja pegado al
                agregado hasta la bodega y solo tras el commit sale al bus y al correo.
              </p>
            </div>
          </div>
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: var(--teal)"></span>
            <div>
              <h3>La bodega confirma en bloque</h3>
              <p>
                Agregado y eventos en la misma transacción. La publicación es cosa de después:
                cada suscriptor entrega en la suya y su fallo no deshace el commit.
              </p>
            </div>
          </div>
          <div class="pzLegend__item">
            <span class="pzDot" style="--c: var(--lima-deep)"></span>
            <div>
              <h3>La guardia no negocia</h3>
              <p>
                Antes de tocar nada se comprueban las invariantes: sin líneas duplicadas, importes
                positivos, un máximo de líneas. Si una falla, el cambio entero se rechaza.
              </p>
            </div>
          </div>
        </div>

        <div class="pzCtl reveal">
          <h3>Controles</h3>
          <ul>
            {
              controles.map((c) => (
                <li>
                  <strong>{c.t}.</strong> {c.d}
                </li>
              ))
            }
            <li>
              <strong>Tocar un edificio</strong> abre su ficha (también los rótulos y los botones
              del panel). Tocar el césped la cierra.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ FICHAS ============ -->
    <section class="pzSec pzSec--ink">
      <div class="wrap">
        <p class="eyebrow reveal">Fichas</p>
        <h2 class="section-title reveal">Los lugares de la ciudadela</h2>
        <div class="pzCards">
          {
            CONCEPTOS.map((c, i) => (
              <article class="pzCard reveal">
                <span class="pzCard__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="pzCard__tag">{c.tag}</span>
                <h3>{c.title}</h3>
                <p>{c.largo}</p>
                <p class="pzCard__regla">
                  <b>Regla:</b> {c.regla}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ TABLA ============ -->
    <section class="pzSec">
      <div class="wrap">
        <p class="eyebrow reveal">Mapa</p>
        <h2 class="section-title reveal">Del modelo al mundo</h2>
        <p class="pzLead reveal">
          DDD táctico responde <em>cómo cambiar el modelo sin romperlo</em>. Cada pieza tiene su
          puesto en la ciudadela — y este es el recorrido que siguen los residentes.
        </p>
        <div class="pzTableWrap reveal">
          <table class="pzTable">
            <thead>
              <tr>
                <th scope="col">Pieza táctica</th>
                <th scope="col">Qué hace</th>
                <th scope="col">En el parque</th>
              </tr>
            </thead>
            <tbody>
              {
                equivalencias.map(([a, b, c]) => (
                  <tr>
                    <td>{a}</td>
                    <td>{b}</td>
                    <td>{c}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============ GLOSARIO ============ -->
    <section class="pzSec pzSec--ink">
      <div class="wrap">
        <p class="eyebrow reveal">Dudas frecuentes</p>
        <h2 class="section-title reveal">Cuatro pares que se confunden</h2>
        <div class="pzGlos">
          {
            glosario.map((g) => (
              <article class="pzGlos__item reveal">
                <h3>{g.t}</h3>
                <p>{g.d}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ PRECISIÓN ============ -->
    <section class="pzSec pzSec--note">
      <div class="wrap">
        <p class="eyebrow reveal">Notación precisa</p>
        <h2 class="section-title reveal">Lo que este parque cuida</h2>
        <ol class="pzNotes reveal">
          {
            precisiones.map((p) => (
              <li>{p}</li>
            ))
          }
        </ol>
        <p class="pzSrc reveal">
          Fuentes: Eric Evans, <em>Domain-Driven Design</em> (2003) y su charla sobre eventos de
          dominio (QCon London, 2009) · Vaughn Vernon, <em>Implementing Domain-Driven Design</em>{' '}
          (2013) y <em>Effective Aggregate Design</em> (2011) · Jimmy Nilsson,{' '}
          <em>Applying Domain-Driven Design and Patterns</em> (2006) para el reparto entre caso de
          uso y agregado.
        </p>
      </div>
    </section>
  </main>

  <footer class="pzFoot">
    <div class="wrap pzFoot__inner">
      <a class="btn" href={`${base}/`}>← Volver al inicio</a>
      <p>Parque Táctica · simulación hecha con Astro + React Three Fiber</p>
    </div>
  </footer>
</Layout>

<style>
  .pzSec {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    border-bottom: 3px solid var(--ink);
  }

  .pzSec .eyebrow {
    margin-bottom: 0.8rem;
  }

  .pzSec--ink {
    background: var(--ink);
    color: var(--cream);
  }

  .pzSec--ink .eyebrow {
    color: var(--cream);
  }

  .pzSec--note {
    background: color-mix(in srgb, var(--amarillo) 22%, var(--cream));
  }

  /* ---------- leyenda ---------- */
  .pzLegend {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
    gap: 1.1rem;
  }

  .pzLegend__item {
    display: flex;
    gap: 0.85rem;
    background: var(--paper);
    border: var(--stroke);
    border-radius: 14px;
    box-shadow: var(--shadow-hard-sm);
    padding: 1.1rem 1.1rem 1.2rem;
  }

  .pzDot {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.3rem;
    border-radius: 5px;
    border: 2px solid var(--ink);
    background: var(--c, var(--amarillo));
    transform: rotate(-6deg);
  }

  .pzLegend h3 {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
    min-height: 2.3em;
  }

  .pzLegend p {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .pzCtl {
    margin-top: 2.2rem;
    background: var(--paper);
    border: var(--stroke);
    border-radius: 14px;
    box-shadow: var(--shadow-hard-sm);
    padding: 1.3rem 1.4rem;
  }

  .pzCtl h3 {
    font-size: 1.15rem;
    margin-bottom: 0.7rem;
  }

  .pzCtl ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .pzCtl strong {
    color: var(--ink);
  }

  /* ---------- fichas ---------- */
  .pzCards {
    margin-top: 2.4rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.2rem;
  }

  .pzCard {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    border: var(--stroke);
    border-radius: 16px;
    box-shadow: var(--shadow-hard-sm);
    padding: 1.4rem 1.3rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .pzCard__num {
    position: absolute;
    top: -0.85rem;
    right: 1rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    background: var(--amarillo);
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    box-shadow: 2px 2px 0 var(--ink);
  }

  .pzCard__tag {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .pzCard h3 {
    font-size: 1.28rem;
  }

  .pzCard p {
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .pzCard__regla {
    margin-top: auto;
    background: color-mix(in srgb, var(--amarillo) 38%, var(--cream));
    border: 2px solid var(--ink);
    border-radius: 10px;
    padding: 0.6rem 0.7rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink);
  }

  .pzCard__regla b {
    font-family: var(--font-display);
    margin-right: 0.3rem;
  }

  /* ---------- glosario ---------- */
  .pzGlos {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16.5rem, 1fr));
    gap: 1.1rem;
  }

  .pzGlos__item {
    background: color-mix(in srgb, var(--cream) 7%, transparent);
    border: 2px solid color-mix(in srgb, var(--cream) 32%, transparent);
    border-radius: 14px;
    padding: 1.15rem 1.15rem 1.2rem;
  }

  .pzGlos__item h3 {
    font-size: 1.05rem;
    margin-bottom: 0.45rem;
    color: var(--amarillo);
  }

  .pzGlos__item p {
    font-size: 0.92rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--cream) 82%, transparent);
  }

  /* ---------- tabla ---------- */
  .pzLead {
    margin-top: 1.2rem;
    max-width: 46rem;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    color: var(--ink-soft);
  }

  .pzLead em {
    font-style: normal;
    font-weight: 700;
    color: var(--ink);
    background: linear-gradient(
      transparent 58%,
      var(--amarillo) 58%,
      var(--amarillo) 94%,
      transparent 94%
    );
  }

  .pzTableWrap {
    margin-top: 2.2rem;
    overflow-x: auto;
    border: var(--stroke);
    border-radius: 14px;
    box-shadow: var(--shadow-hard-sm);
    background: var(--paper);
  }

  .pzTable {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .pzTable th,
  .pzTable td {
    text-align: left;
    padding: 0.85rem 1.1rem;
    border-bottom: 2px solid color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .pzTable th {
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--ink);
    color: var(--cream);
  }

  .pzTable tr:last-child td {
    border-bottom: 0;
  }

  .pzTable td:last-child {
    font-weight: 600;
  }

  /* ---------- notas ---------- */
  .pzNotes {
    margin-top: 2rem;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 52rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  .pzNotes li {
    padding-left: 0.4rem;
  }

  .pzNotes li::marker {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--aji);
  }

  .pzSrc {
    margin-top: 1.8rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    max-width: 52rem;
  }

  .pzSrc em {
    font-style: italic;
  }

  /* ---------- footer ---------- */
  .pzFoot {
    background: var(--ink);
    color: var(--cream);
    padding-block: 2.2rem;
  }

  .pzFoot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.92rem;
  }

  .pzFoot p {
    color: color-mix(in srgb, var(--cream) 60%, transparent);
  }

  @media (max-width: 720px) {
    .pzTable th,
    .pzTable td {
      padding: 0.7rem 0.8rem;
    }
  }
</style>
