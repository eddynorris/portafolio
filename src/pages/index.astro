---
import Layout from '../layouts/Layout.astro';
import HeroScene from '../components/HeroScene.tsx';
import CartPanel from '../components/CartPanel';
import ThemeToggle from '../components/ThemeToggle.astro';
import { cv, enlaces, parques, perfil, proyectos, skills, whatsapp } from '../data/portfolio';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const wpp = `${whatsapp.href}?text=${encodeURIComponent('Hola Eddy, te escribo desde tu portafolio.')}`;
const email = enlaces.find((e) => e.label === 'Email');
const github = enlaces.find((e) => e.label === 'GitHub');
---

<Layout>
  <header class="nav">
    <a class="nav__brand" href="#main">
      <span class="nav__dot"></span>
      {perfil.nombre}
    </a>
    <nav class="nav__links" aria-label="Principal">
      <a href="#proyectos">Proyectos</a>
      <span class="nav__group">
        <a class="nav__menu" href="#educador">Educador <i class="nav__caret" aria-hidden="true">▾</i></a>
        <span class="nav__pop">
          {parques.filter((p) => p.slug).map((p) => <a href={p.slug}>{p.titulo}</a>)}
          <a href={`${base}/educador`}>Ver todos →</a>
        </span>
      </span>
      <a href="#skills">Skills</a>
      <a href="#contacto">Contacto</a>
      <a href={cv.href} download>CV</a>
    </nav>
    <ThemeToggle />
    <details class="nav__burger">
      <summary aria-label="Abrir menú">
        <span class="nav__burgerLines" aria-hidden="true"><i></i><i></i><i></i></span>
      </summary>
      <nav class="nav__burgerPanel" aria-label="Menú">
        <a href="#proyectos">Proyectos</a>
        <a href="#educador">Educador</a>
        <a href="#skills">Skills</a>
        <a href="#contacto">Contacto</a>
        <a href={cv.href} download>CV</a>
        <a class="nav__burgerCta" href={wpp} target="_blank" rel="noreferrer">Hablemos por WhatsApp</a>
      </nav>
    </details>
    <a class="btn btn--small" href={wpp} target="_blank" rel="noreferrer">Hablemos</a>
  </header>

  <!-- Escena 3D fija detrás de toda la historia: la cámara viaja con el scroll -->
  <div class="stage" aria-hidden="true">
    <HeroScene client:only="react" />
    <div class="stage__scrim"></div>
  </div>

  <main id="main" class="story">
    <!-- ============ HERO ============ -->
    <section class="hero" data-station="0">
      <div class="hero__copy wrap">
        <p class="eyebrow">{perfil.disponibilidad}</p>
        <h1 class="hero__title">
          <span>Diseño y programo</span>
          <span>experiencias <em>3D</em></span>
          <span>que se sienten vivas.</span>
        </h1>
        <p class="hero__lead">
          Soy {perfil.nombre}, <strong>{perfil.rol}</strong> en {perfil.ciudad}.
          Angular y Flask por detrás, React Native en el móvil, agentes de IA para acelerar, y
          una escena 3D que corre a 60&nbsp;fps.
        </p>
        <div class="hero__cta">
          <a class="btn" href="#proyectos">Ver proyectos <span aria-hidden="true">↓</span></a>
          <a class="btn btn--ghost" href={cv.href} download>Descargar CV</a>
        </div>
        <p class="hero__touch">
          <span class="hero__touchDot" aria-hidden="true"></span>
          Toca el letrero, el menú o la sombrilla del carrito
        </p>
      </div>

      <div class="hero__hint" aria-hidden="true">
        <span>scroll</span>
        <i></i>
      </div>
      <div class="hero__badge" aria-hidden="true">
        <span class="hero__badgeText">hecho con three.js · r186</span>
      </div>
    </section>

    <!-- ============ MARQUEE ============ -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {
          Array.from({ length: 2 }).map(() => (
            <span class="marquee__row">
              {[
                'ANGULAR',
                'PYTHON & FLASK',
                'REACT NATIVE',
                'REST APIs',
                'DESPLIEGUE CLOUD',
                'AWS · RAILWAY · VERCEL',
                'AGENTES DE IA',
                'CURSOR',
                'CLAUDE CODE',
                'OPENCODE',
              ].map((w) => (
                <b>
                  {w} <i>✦</i>
                </b>
              ))}
            </span>
          ))
        }
      </div>
    </div>

    <!-- ============ PROYECTOS ============ -->
    <section class="station" id="proyectos" data-station="1" aria-labelledby="t-proyectos">
      <div class="card reveal">
        <p class="eyebrow"><span class="card__n">01</span> Lo que anuncia el letrero</p>
        <h2 class="card__title" id="t-proyectos">Proyectos</h2>
        <p class="card__lead">Trabajo real para empresas: del análisis del negocio a la app en producción.</p>
        <ol class="projects">
          {
            proyectos.map((p, i) => (
              <li class="project">
                <div class="project__cover" style={{ background: p.grad }}>
                  <span class="project__num">{String(i + 1).padStart(2, '0')}</span>
                </div>
                <div class="project__body">
                  <p class="project__meta">{p.año}</p>
                  <h3>{p.titulo}</h3>
                  <p>{p.resumen}</p>
                  <ul class="tags">
                    {p.tags.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ============ EDUCADOR ============ -->
    <section class="station" id="educador" data-station="2" aria-labelledby="t-educador">
      <div class="card reveal">
        <p class="eyebrow"><span class="card__n">02</span> Educador</p>
        <h2 class="card__title" id="t-educador">Arquitectura que se recorre</h2>
        <p class="card__lead">
          Parques 3D interactivos donde los patrones de software se ven funcionar: cada invitado es
          una petición, cada atracción una capa. Con pausa, velocidad y manual en español.
        </p>
        <ul class="parks">
          {
            parques.map((p) => (
              <li class="park" data-off={p.slug ? 'false' : 'true'}>
                {p.img ? (
                  <img class="park__img" src={p.img} alt="" width="320" height="200" loading="lazy" decoding="async" />
                ) : (
                  <span class="park__img park__img--soon" aria-hidden="true">
                    Pronto
                  </span>
                )}
                <div class="park__body">
                  <span class="park__tag" style={{ '--c': p.color }}>
                    {p.etiqueta}
                  </span>
                  <h3>
                    {p.slug ? (
                      <a href={p.slug}>
                        {p.titulo} <span aria-hidden="true">→</span>
                      </a>
                    ) : (
                      p.titulo
                    )}
                  </h3>
                </div>
              </li>
            ))
          }
        </ul>
        <a class="btn btn--ghost card__more" href={`${base}/educador`}>Ver la sección Educador</a>
      </div>
    </section>

    <!-- ============ SKILLS ============ -->
    <section class="station" id="skills" data-station="3" aria-labelledby="t-skills">
      <div class="card reveal">
        <p class="eyebrow"><span class="card__n">03</span> El menú de hoy</p>
        <h2 class="card__title" id="t-skills">Skills</h2>
        <p class="card__lead">Qué sé hacer, dónde me formé y qué tengo certificado.</p>
        <div class="skills">
          {
            skills.map((g) => (
              <article class="skill">
                <h3>{g.grupo}</h3>
                <ul class="tags">
                  {g.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ CONTACTO ============ -->
    <section class="station station--last" id="contacto" data-station="4" aria-labelledby="t-contacto">
      <div class="card card--cta reveal">
        <p class="eyebrow"><span class="card__n">04</span> {perfil.disponibilidad}</p>
        <h2 class="card__title" id="t-contacto">¿Tienes un proyecto en mente?</h2>
        <p class="card__lead">
          Webs, apps móviles, APIs o una experiencia 3D como esta. Cuéntame qué necesitas y
          conversamos.
        </p>
        <div class="cta">
          <a class="btn" href={wpp} target="_blank" rel="noreferrer">
            Escríbeme por WhatsApp <span aria-hidden="true">↗</span>
          </a>
          {email && <a class="btn btn--ghost" href={email.href}>Email</a>}
          {
            github && (
              <a class="btn btn--ghost" href={github.href} target="_blank" rel="noreferrer">
                GitHub ↗
              </a>
            )
          }
          <a class="btn btn--ghost" href={cv.href} download>CV (PDF) ↓</a>
        </div>
        <p class="cta__note">{whatsapp.visible} · {perfil.ciudad}</p>
      </div>
    </section>
  </main>

  <CartPanel client:only="react" />

  <footer class="foot">
    <div class="wrap foot__inner">
      <p>© {new Date().getFullYear()} {perfil.nombre}. Ceviche recién hecho.</p>
      <p class="foot__meta">Astro + React Three Fiber · {perfil.ciudad}</p>
    </div>
  </footer>
</Layout>

<style>
  /* ---------------- nav ---------------- */
  .nav {
    position: fixed;
    z-index: 40;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 2rem);
    padding: 0.9rem var(--gutter);
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--cream) 72%, transparent);
    border-bottom: 2px solid var(--ink);
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    font-size: 1.05rem;
  }
  .nav__dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--aji);
    border: 2px solid var(--ink);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.35); }
  }
  .nav__links {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    margin-left: auto;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .nav__links a {
    position: relative;
    padding-bottom: 2px;
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 2px;
    background: var(--aji);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav__links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav__group {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav__caret {
    font-style: normal;
    font-size: 0.62em;
    display: inline-block;
    transform: translateY(-1px);
    transition: transform 0.2s ease;
  }
  .nav__group:hover .nav__caret {
    transform: translateY(1px);
  }
  .nav__pop {
    position: absolute;
    top: calc(100% + 0.55rem);
    left: -0.8rem;
    display: flex;
    flex-direction: column;
    min-width: max-content;
    background: var(--paper);
    border: var(--stroke);
    border-radius: 12px;
    box-shadow: var(--shadow-hard-sm);
    padding: 0.4rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
  }
  .nav__group:hover .nav__pop,
  .nav__group:focus-within .nav__pop {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .nav__pop a {
    padding: 0.45rem 0.7rem;
    border-radius: 8px;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .nav__pop a::after {
    content: none;
  }
  .nav__pop a:hover {
    background: color-mix(in srgb, var(--amarillo) 40%, transparent);
  }
  .btn--small {
    padding: 0.5rem 1.05rem;
    font-size: 0.88rem;
    box-shadow: 3px 3px 0 var(--ink);
  }
  .nav__burger {
    display: none;
    position: relative;
    margin-left: auto;
  }
  .nav__burger summary {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    border: var(--stroke);
    border-radius: 999px;
    background: var(--paper);
    box-shadow: var(--shadow-hard-sm);
    cursor: pointer;
    list-style: none;
    transition:
      transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.18s ease;
  }
  .nav__burger summary::-webkit-details-marker {
    display: none;
  }
  .nav__burger summary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--ink);
  }
  .nav__burger summary:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .nav__burgerLines {
    display: grid;
    gap: 4px;
    width: 18px;
  }
  .nav__burgerLines i {
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav__burger[open] .nav__burgerLines i:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .nav__burger[open] .nav__burgerLines i:nth-child(2) {
    transform: scaleX(0);
  }
  .nav__burger[open] .nav__burgerLines i:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  .nav__burgerPanel {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    display: flex;
    flex-direction: column;
    min-width: 15rem;
    padding: 0.45rem;
    background: var(--paper);
    border: var(--stroke);
    border-radius: 12px;
    box-shadow: var(--shadow-hard-sm);
  }
  .nav__burgerPanel a {
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .nav__burgerPanel a:hover {
    background: color-mix(in srgb, var(--amarillo) 40%, transparent);
  }
  .nav__burgerPanel .nav__burgerCta {
    margin-top: 0.35rem;
    border-top: 2px dashed color-mix(in srgb, var(--ink) 25%, transparent);
    border-radius: 0 0 8px 8px;
    font-weight: 700;
    color: var(--aji);
  }
  @media (max-width: 720px) {
    .nav__links { display: none; }
    .nav :global(.themeToggle) { margin-left: auto; }
    .nav__burger { display: block; margin-left: 0; }
    .nav__brand {
      font-size: 0.98rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      min-width: 0;
    }
  }
  @media (max-width: 480px) {
    .nav .btn--small { display: none; }
  }

  /* ---------------- escena fija ---------------- */
  .stage {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, #2f9fe0, #8fdcff 55%, #ffe9c9);
  }
  :global([data-theme='night']) .stage {
    background: linear-gradient(180deg, #05060f, #0d1b33 60%, #1a2b4a);
  }
  .stage__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--cream) 80%, transparent) 0%,
      color-mix(in srgb, var(--cream) 40%, transparent) 30%,
      transparent 52%
    );
  }
  /* viñeta suave (antes la hacía el postproceso; en CSS no cuesta GPU) */
  .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 90% at 62% 48%, transparent 55%, rgb(10 12 30 / 0.28) 100%);
  }
  .story {
    position: relative;
    z-index: 1;
    /* deja pasar el puntero a la escena salvo en tarjetas y enlaces */
    pointer-events: none;
  }
  .story a,
  .story button,
  .story .card,
  .story .marquee {
    pointer-events: auto;
  }

  /* ---------------- hero ---------------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }
  .hero__copy {
    position: relative;
    z-index: 2;
    padding-block: 7rem 5rem;
    width: min(100% - var(--gutter) * 2, 44rem, 54vw);
    margin-inline: var(--gutter) auto;
  }
  .hero__title {
    margin-top: 1.1rem;
    font-size: clamp(2.4rem, 1rem + 4.3vw, 4.8rem);
    display: flex;
    flex-direction: column;
    gap: 0.06em;
  }
  .hero__title span {
    display: block;
    opacity: 0;
    transform: translateY(0.5em) rotate(-1.4deg);
    animation: lineIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero__title span:nth-child(1) { animation-delay: 0.15s; }
  .hero__title span:nth-child(2) { animation-delay: 0.27s; }
  .hero__title span:nth-child(3) { animation-delay: 0.39s; }
  @keyframes lineIn {
    to { opacity: 1; transform: none; }
  }
  .hero__title em {
    font-style: normal;
    position: relative;
    color: var(--ink);
    background: linear-gradient(
      transparent 58%,
      var(--highlight, var(--amarillo)) 58%,
      var(--highlight, var(--amarillo)) 94%,
      transparent 94%
    );
    padding-inline: 0.1em;
  }
  .hero__lead {
    margin-top: 1.5rem;
    max-width: 30rem;
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.18rem);
    color: var(--ink-soft);
    opacity: 0;
    animation: lineIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.55s forwards;
  }
  .hero__lead strong { color: var(--ink); }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
    opacity: 0;
    animation: lineIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.7s forwards;
  }
  .hero__touch {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.4rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-soft);
    opacity: 0;
    animation: lineIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.95s forwards;
  }
  .hero__touchDot {
    width: 0.62rem;
    height: 0.62rem;
    flex: none;
    border-radius: 50%;
    background: var(--aji);
    border: 2px solid var(--ink);
    animation: pulse 1.9s ease-in-out infinite;
  }
  .hero__hint {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    bottom: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .hero__hint i {
    width: 3.4rem;
    height: 2px;
    background: var(--ink);
    position: relative;
    overflow: hidden;
  }
  .hero__hint i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--aji);
    animation: sweep 1.9s ease-in-out infinite;
  }
  @keyframes sweep {
    0% { transform: translateX(-100%); }
    60%, 100% { transform: translateX(100%); }
  }
  .hero__badge {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    bottom: 1.4rem;
  }
  .hero__badgeText {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.42rem 0.85rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
    box-shadow: 3px 3px 0 var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* ---------------- estaciones (secciones sobre la escena) ---------------- */
  .station {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 7rem var(--gutter) 5rem;
  }
  .station--last {
    min-height: 92svh;
  }
  .card {
    width: min(100%, 35rem);
    padding: clamp(1.4rem, 1rem + 1.5vw, 2.2rem);
    background: color-mix(in srgb, var(--paper) 93%, transparent);
    backdrop-filter: blur(10px);
    border: var(--stroke);
    border-radius: 22px;
    box-shadow: var(--shadow-hard);
  }
  .card__n {
    font-variant-numeric: tabular-nums;
    color: var(--aji);
  }
  .card .eyebrow::before {
    display: none;
  }
  .card__title {
    margin-top: 0.6rem;
    font-size: clamp(2.1rem, 1.3rem + 2.6vw, 3.4rem);
  }
  .card__lead {
    margin-top: 0.8rem;
    color: var(--ink-soft);
  }
  .card__more {
    margin-top: 1.4rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.2rem 0.6rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: color-mix(in srgb, var(--teal) 16%, var(--paper));
  }

  /* proyectos */
  .projects {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }
  .project {
    display: grid;
    grid-template-columns: 4.4rem 1fr;
    gap: 1rem;
    padding: 0.9rem;
    border: var(--stroke);
    border-radius: 16px;
    background: var(--paper);
    transition:
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.2s ease;
  }
  .project:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hard-sm);
  }
  .project__cover {
    display: grid;
    place-items: end start;
