---
import { proyectos } from '../data/portfolio';
---

<section id="proyectos" class="sec">
  <div class="wrap">
    <header class="sec__head reveal">
      <p class="eyebrow">Trabajos seleccionados</p>
      <h2 class="section-title">Proyectos</h2>
      <p class="sec__sub">
        Una muestra de lo que pasa cuando el motion design y el código se sientan a la misma mesa.
      </p>
    </header>

    <ul class="grid">
      {
        proyectos.map((p, i) => (
          <li class="card reveal" style={`transition-delay:${(i % 3) * 90}ms`}>
            <a href={p.href} class="card__link">
              <div class="card__cover" style={`background:${p.grad}`}>
                <span class="card__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="card__year">{p.año}</span>
                <span class="card__go" aria-hidden="true">
                  ↗
                </span>
              </div>
              <div class="card__body">
                <h3>{p.titulo}</h3>
                <p>{p.resumen}</p>
                <ul class="card__tags">
                  {p.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sec {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: var(--cream);
  }
  .sec__head {
    display: grid;
    gap: 0.9rem;
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .sec__sub {
    color: var(--ink-soft);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    max-width: 38rem;
  }

  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(1.2rem, 2.4vw, 2rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }

  .card {
    border: var(--stroke);
    border-radius: 20px;
    background: var(--paper);
    box-shadow: var(--shadow-hard);
    overflow: hidden;
    transition:
      transform 0.35s cubic-bezier(0.34, 1.4, 0.64, 1),
      box-shadow 0.35s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .card:hover {
    transform: translate(-5px, -7px);
    box-shadow: 11px 13px 0 var(--ink);
  }
  .card__link {
    display: block;
    height: 100%;
  }

  .card__cover {
    position: relative;
    aspect-ratio: 16 / 10;
    border-bottom: var(--stroke);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 0.9rem 1rem;
    overflow: hidden;
    isolation: isolate;
  }
  .card__cover::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 78% 20%, rgba(255, 255, 255, 0.55), transparent 55%),
      repeating-linear-gradient(
        -45deg,
        rgba(23, 18, 43, 0.12) 0 2px,
        transparent 2px 13px
      );
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card:hover .card__cover::after {
    transform: scale(1.35) rotate(6deg);
  }

  .card__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    line-height: 1;
    color: var(--ink);
    text-shadow: 3px 3px 0 rgba(255, 247, 234, 0.75);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .card:hover .card__num {
    transform: translateY(-4px) rotate(-4deg);
  }
  .card__year {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
  }
  .card__go {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px solid var(--ink);
    background: var(--amarillo);
    font-size: 1.1rem;
    transform: translateY(0.6rem) scale(0.7);
    opacity: 0;
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .card:hover .card__go {
    transform: none;
    opacity: 1;
  }

  .card__body {
    padding: 1.15rem 1.2rem 1.35rem;
    display: grid;
    gap: 0.55rem;
  }
  .card__body h3 {
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.65rem);
  }
  .card__body p {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .card__tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }
  .card__tags li {
    font-size: 0.74rem;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.24rem 0.6rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: color-mix(in srgb, var(--teal) 22%, var(--paper));
  }
</style>
