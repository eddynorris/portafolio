---
import { skills } from '../data/portfolio';
---

<section id="skills" class="sec">
  <div class="wrap">
    <header class="sec__head reveal">
      <p class="eyebrow">Con qué trabajo</p>
      <h2 class="section-title">Skills</h2>
      <p class="sec__sub">
        Backend, agentes de IA y video generativo: con eso paso del boceto a algo desplegado y
        funcionando.
      </p>
    </header>

    <div class="skills">
      {
        skills.map((g, i) => (
          <article class="group reveal" style={`transition-delay:${i * 80}ms`}>
            <div class="group__head">
              <span class="group__index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{g.grupo}</h3>
            </div>
            <ul class="chips">
              {g.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="strip reveal">
      <div class="strip__bar" style="--w:92%"><span>Python · Flask · REST APIs</span></div>
      <div class="strip__bar" style="--w:95%"><span>Agentes de IA · Claude Code</span></div>
      <div class="strip__bar" style="--w:84%"><span>Video generativo · ComfyUI</span></div>
    </div>
  </div>
</section>

<style>
  .sec {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background:
      linear-gradient(180deg, var(--paper), var(--cream));
    border-block: 3px solid var(--ink);
  }
  .sec__head {
    display: grid;
    gap: 0.9rem;
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .sec__sub {
    color: var(--ink-soft);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    max-width: 38rem;
  }

  .skills {
    display: grid;
    gap: clamp(1rem, 2vw, 1.6rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  }

  .group {
    border: var(--stroke);
    border-radius: 18px;
    background: var(--paper);
    padding: 1.2rem 1.25rem 1.4rem;
    box-shadow: var(--shadow-hard-sm);
    transition: transform 0.3s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .group:hover {
    transform: translateY(-6px) rotate(-0.6deg);
  }
  .group:nth-child(2) { background: color-mix(in srgb, var(--amarillo) 22%, var(--paper)); }
  .group:nth-child(3) { background: color-mix(in srgb, var(--teal) 16%, var(--paper)); }
  .group:nth-child(4) { background: color-mix(in srgb, var(--fucsia) 14%, var(--paper)); }

  .group__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
    padding-bottom: 0.7rem;
    border-bottom: 2px dashed color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .group__index {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8rem;
    color: var(--aji);
    letter-spacing: 0.1em;
  }
  .group h3 {
    font-size: 1.28rem;
  }

  .chips {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }
  .chips li {
    font-size: 0.83rem;
    font-weight: 500;
    padding: 0.3rem 0.7rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--cream);
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      background 0.25s ease;
  }
  .chips li:hover {
    transform: translateY(-3px) scale(1.06);
    background: var(--amarillo);
  }

  .strip {
    margin-top: clamp(2rem, 4vw, 3.2rem);
    display: grid;
    gap: 0.9rem;
  }
  .strip__bar {
    position: relative;
    height: 2.4rem;
    border: var(--stroke);
    border-radius: 999px;
    background: var(--paper);
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .strip__bar::before {
    content: '';
    position: absolute;
    inset: 0;
    width: var(--w);
    background: repeating-linear-gradient(
      -45deg,
      var(--teal) 0 10px,
      color-mix(in srgb, var(--teal) 72%, white) 10px 20px
    );
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .is-in .strip__bar::before {
    transform: scaleX(1);
  }
  .strip__bar span {
    position: relative;
    padding-inline: 1.1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    mix-blend-mode: normal;
  }
</style>
