---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { perfil, enlaces } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
}

const { title = perfil.nombre, description = perfil.tagline } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://eddynorris.github.io');
const ogImage = new URL(`${base}/og.jpg`, Astro.site ?? 'https://eddynorris.github.io');
const github = enlaces.find((e) => e.label === 'GitHub')?.href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: perfil.nombre,
  jobTitle: perfil.rol,
  url: canonical.href,
  email: 'eddy.sagitario.97@gmail.com',
  sameAs: github ? [github] : [],
  address: { '@type': 'PostalAddress', addressLocality: perfil.ciudad },
  knowsAbout: [
    'Angular',
    'Flask',
    'Python',
    'React Native',
    'Despliegue en la nube',
    'Three.js',
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={`${perfil.nombre} — Portafolio`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#fff7ea" />
    <script is:inline>
      /* Fija el tema antes del primer render: sin flash. Síncrono en <head>. */
      (function () {
        try {
          var t = null;
          try {
            t = localStorage.getItem('portfolio-theme');
          } catch (e) {
            /* storage bloqueado */
          }
          if (t !== 'light' && t !== 'night') {
            t =
              window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'night'
                : 'light';
          }
          var r = document.documentElement;
          r.setAttribute('data-theme', t);
          r.style.colorScheme = t;
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', t === 'night' ? '#0c0a1a' : '#fff7ea');
        } catch (e) {
          /* nunca bloquear el render */
        }
      })();
    </script>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-dm-sans" />
    <slot name="head" />
  </head>
  <body>
    <a class="skipLink" href="#main">Saltar al contenido</a>
    <slot />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      /* Menú móvil: se cierra al tocar fuera o al elegir una opción. */
      document.addEventListener('click', (e) => {
        document.querySelectorAll('details.nav__burger[open]').forEach((d) => {
          if (e.target.closest('a') || !d.contains(e.target)) d.removeAttribute('open');
        });
      });
    </script>
  </body>
</html>
